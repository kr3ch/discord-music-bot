# ─────────────────────────────────────────────
# Discord (required)
# ─────────────────────────────────────────────
DISCORD_TOKEN=your-discord-bot-token-here
CLIENT_ID=your-discord-application-client-id
# Optional: if set, slash commands are registered only on this guild (instant).
# Leave empty to register globally (takes up to 1 hour to propagate).
DEV_GUILD_ID=

# ─────────────────────────────────────────────
# Spotify (optional — only needed for spotify links)
# Create app at https://developer.spotify.com/dashboard
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Lyrics (optional)
# If GENIUS_TOKEN is set, Genius API is used (better quality).
# Otherwise free lyrics.ovh is used as fallback.
# Get token: https://genius.com/api-clients
# ─────────────────────────────────────────────
GENIUS_TOKEN=

# ─────────────────────────────────────────────
# Database
# Default: SQLite file. Switch to Postgres by changing both this URL
# AND `provider` in prisma/schema.prisma to "postgresql", then run
# `npm run prisma:migrate`.
# Examples:
#   sqlite:   file:./data/bot.db
#   postgres: postgresql://user:pass@localhost:5432/musicbot
# ─────────────────────────────────────────────
DATABASE_URL="file:./data/bot.db"

# ─────────────────────────────────────────────
# Bot tuning (optional, sensible defaults)
# ─────────────────────────────────────────────
LOG_LEVEL=info
# Idle disconnect: seconds the bot stays alone in voice before leaving.
LEAVE_ON_EMPTY_TIMEOUT=60
# Default per-user cooldown for commands (ms).
DEFAULT_COOLDOWN_MS=2000
# Max items per /queue page.
QUEUE_PAGE_SIZE=10
# Max tracks allowed in one queue.
MAX_QUEUE_SIZE=500
# Path to yt-dlp binary. Leave empty to use the one on $PATH.
YTDLP_PATH=
# Path to ffmpeg binary. Leave empty to use ffmpeg-static / $PATH.
FFMPEG_PATH=
